# Copy this file to .env and fill in values. Never commit .env.

# development | production   (tests set "testing" themselves)
APP_ENV=development

# Any long random string. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=f18323cd2860ddb764b3620d3148e7d8be729d639c0b2635449365f6d8c515e2

# Leave empty to use a local SQLite file (instance/dev.sqlite).
# For Neon, paste the connection string as-is (postgresql://...?sslmode=require).
DATABASE_URL=

# Only for `pytest -m postgres`. Use a THROWAWAY database or Neon branch: the tests drop all tables.
TEST_DATABASE_URL=
