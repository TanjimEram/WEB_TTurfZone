# Copy this file to .env and fill in values. Never commit .env.

# development | production   (tests set "testing" themselves)
APP_ENV=development

# Any long random string. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Leave empty to use a local SQLite file (instance/dev.sqlite).
# Production is MariaDB on the host (CR-4):  mysql+pymysql://<user>:<password>@localhost/<database>?charset=utf8mb4
# (postgresql://... still works, needs psycopg from requirements-dev.txt.)
DATABASE_URL=

# Only for `pytest -m mariadb` (mysql+pymysql://...) or `pytest -m postgres` (postgresql://...).
# The URL's scheme picks which marker runs. Use a THROWAWAY database: the tests drop all tables.
TEST_DATABASE_URL=
